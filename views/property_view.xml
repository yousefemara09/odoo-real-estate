<odoo>
    <record id="property_view_tree" model="ir.ui.view">
        <field name="name">property.tree</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <tree decoration-danger="(is_date)">
                <header>
                    <button class="btn-primary" name="report_execl_print" string="Print Excel File"
                            type="object"/>
                </header>
                <field name="name"/>
                <field name="ref"/>
                <field name="owner_id"/>
                <field name="expected_price"/>
                <field name="tag_ids"/>
                <field name="bedrooms" />
                <field name="postcode" />
                <field name="check_selling_date" />
                <field name="is_date" invisible="1" />
                <field name="state"/>
                <field name="garden_orientation" optional="1"/>
                <field name="facades" optional="1"/>
            </tree>
        </field>
    </record>


<record id="property_view_form" model="ir.ui.view">
    <field name="name">property.form</field>
    <field name="model">property</field>
    <field name="arch" type="xml">
        <form>
            <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
            <widget name="web_ribbon" title="Sold" bg_color="btn-success" invisible="state != 'sold'"/>

            <header>
                <button name="action" type="object" string="Action" class="btn-primary"/>
                <button name="get_properties" type="object" string="Test Call GET Properties" class="btn-primary"/>
                <button name="action_draft" type="object" string="Draft" class="btn-primary" invisible="state == 'draft'"/>
                <button name="action_sold" type="object" string="Sold" class="btn-success" invisible="state != 'draft'"/>
                <button name="action_rejected" type="object" string="Rejected" class="btn-danger" invisible="state in ['rejected', 'closed']"/>
                <button name="action_closed" type="object" string="Closed" class="btn-secondary"/>

                <field name="state" widget="statusbar" statusbar_visible="draft,sold,rejected,closed"/>
            </header>

            <sheet>
                <div name="button_box" class="oe_button_box">
                    <button name="action_open_related_owner"
                            type="object"
                            icon="fa-user"
                            invisible="not owner_id"
                            string="Owner"/>
                    <button name="action_open_related_tag"
                            type="object"
                            icon="fa-user"
                            invisible="not tag_ids"
                            string="Tag"/>
                </div>
                <div class="oe_title">
                    <h1>
                        <field name="ref"/>
                    </h1>
                    <label for="name"/>
                    <h3>
                        <field name="name"/>
                    </h3>
                </div>
                <group col="2">
                    <group string="First Data">
                        <field name="bedrooms"/>
                        <field name="date_availability"/>
                        <field name="expected_price"/>
                        <field name="selling_price"/>
                        <field name="check_selling_date" />
                        <field name="is_date" />
                        <field name="diff"/>
                    </group>

                    <group string="Additional Data">
                        <field name="owner_id"/>
                        <field name="owner_address"/>
                        <field name="owner_phone"/>
                        <field name="facades"/>
                        <field name="garden_orientation"/>
                        <field name="postcode" required="1"/>
                        <field name="tag_ids" widget="many2many_tags"/>
                        <field name="active" />
                    </group>
                </group>

                <notebook>
                    <page string="bedrooms">
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="description"/>
                                <field name="area"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </sheet>
            <div class="oe_chatter">
                <field name="message_follower_ids"/>
                <field name="activity_ids"/>
                <field name="message_ids"/>
            </div>

        </form>
    </field>
</record>
     <record id="property_view_search" model="ir.ui.view">
        <field name="name">property search</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="postcode"/>
                <filter string="Large Properties" name="large_prop" domain="[('bedrooms', '>', 3)]"/>
                <filter string="bedrooms Orientation" name="group_garden" context="{'group_by': 'bedrooms'}"/>
            </search>
        </field>
    </record>

<!--    act_window-->
    <record id="property_action" model="ir.actions.act_window">
        <field name="name">Property</field>
        <field name="res_model">property</field>
        <field name="view_mode">tree,form</field>
    </record>

<!--    server-->
    <record id="property_closed_server_action" model="ir.actions.server">
        <field name="name">Closed Action</field>
        <field name="model_id" ref="model_property"/>
        <field name="binding_model_id" ref="model_property"/>
        <field name="state">code</field>
        <field name="code">
               action=  records.action_closed()
        </field>
    </record>
    <record id="property_change_state_server_action" model="ir.actions.server">
        <field name="name">Change State</field>
        <field name="model_id" ref="model_property"/>
        <field name="binding_model_id" ref="model_property"/>
        <field name="state">code</field>
        <field name="code">
               action=  records.action_change_wizard_state()
        </field>
    </record>



<!--    automation-->
    <record id="property_check_expected_selling" model="ir.cron">
        <field name="name">Property: Check selling date</field>
        <field name="model_id" ref="model_property"/>
        <field name="state">code</field>
        <field name="code">model._check_expected_selling_date()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
<!--Reports    -->
<!--موجود جوا ملف reports    -->



    <menuitem
        id="properties_menu_action"
        name="Properties"
        parent="app_one.properties_menu"
        action="property_action"
    />

    <record id="list_view_action" model="ir.actions.client">
        <field name="name">Properties List View</field>
        <field name="tag">app_one.action_list_view</field>
    </record>


    <menuitem
        id="properties_list_view_action"
        name="Properties OWL"
        parent="app_one.properties_menu"
        action="list_view_action"
    />

</odoo>