<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="app_one.ListView">
        <div class="container mt-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-primary border-bottom border-primary pb-1 mb-0">
                    <i class="fa fa-home me-2"/>Property Home
                </h5>
                <button class="btn btn-sm px-3"
                        t-att-class="state.showCreateform ? 'btn-danger' : 'btn-primary'"
                        t-on-click="toggleCreateForm">
                    <i t-att-class="state.showCreateform ? 'fa fa-times me-1' : 'fa fa-plus me-1'"/>
                    <t t-if="state.showCreateform">Close</t>
                    <t t-else="">New</t>
                </button>
            </div>

            <t t-if="state.showCreateform">
                <FormView onRecordCreated="onRecordCreated" onCancle="toggleCreateForm.bind(this)"/>
            </t>

            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped table-sm table-bordered small mb-0">
                            <thead class="table-primary">
                                <tr>
                                    <th class="fw-semibold ps-3">Name</th>
                                    <th class="fw-semibold">Postcode</th>
                                    <th class="fw-semibold text-center">Bedrooms</th>
                                    <th class="fw-semibold text-center">Garden</th>
                                    <th class="fw-semibold text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.records" t-as="record" t-key="record.id">
                                    <tr>
                                        <td class="ps-3"><t t-esc="record.name"/></td>
                                        <td><t t-esc="record.postcode"/></td>
                                        <td class="text-center"><t t-esc="record.bedrooms"/></td>
                                        <td class="text-center">
                                            <span t-if="record.garden" class="badge bg-success">Yes</span>
                                            <span t-else="" class="badge bg-secondary">No</span>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-danger btn-sm py-0 px-2"
                                                t-on-click="() => this.deleteRecords(record.id)">
                                                <i class="fa fa-trash me-1"/>Delete
                                            </button>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>